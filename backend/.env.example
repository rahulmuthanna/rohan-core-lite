# Copy this file to backend/.env. These are local development values only, not secrets.
# Both databases live on the "db" service in docker-compose.yml (host port 5433).

# The database the application uses.
DATABASE_URL=postgres://rohan:rohan_dev_password@localhost:5433/rohan_core_lite

# A separate database used only by automated tests. It is created automatically
# on the first test run and wiped before every test.
TEST_DATABASE_URL=postgres://rohan:rohan_dev_password@localhost:5433/rohan_core_lite_test

# The port the API listens on.
PORT=4000

NODE_ENV=development
